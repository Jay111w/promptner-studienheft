# ============================================================
#  promptner-studienheft - Konfigurationsvorlage
# ------------------------------------------------------------
#  1. Diese Datei nach ".env" kopieren:   cp .env.example .env
#  2. KISSKI-Key eintragen (Uni-Zugang, siehe Vorlesung Woche 10).
#  3. Die ".env" wird NIEMALS nach GitHub hochgeladen (.gitignore).
# ============================================================

# --- LLM-Endpunkt (KISSKI / GWDG Academic Cloud, OpenAI-kompatibel) ---
KISSKI_API_KEY=
LLM_BASE_URL=https://chat-ai.academiccloud.de/v1
LLM_MODEL=meta-llama-3.1-8b-instruct
LLM_TEMPERATURE=0
LLM_SEED=42
LLM_MAX_WORKERS=4

# --- Schutz gegen weglaufende Experimente ---
MAX_LLM_CALLS_PER_RUN=20000

# --- Ablage ---
CACHE_DIR=.cache/llm
RESULTS_DIR=results

# --- Logging: DEBUG, INFO, WARNING, ERROR ---
LOG_LEVEL=INFO
LOG_DIR=logs

# --- Nur fuer die Korrektor-Demo (optional) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
